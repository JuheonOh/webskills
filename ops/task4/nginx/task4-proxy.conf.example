server {
  listen 80;
  server_name <TASK4_HOST>;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name <TASK4_HOST>;

  # certbot config
  ssl_certificate /etc/letsencrypt/live/<TASK4_HOST>/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/<TASK4_HOST>/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  location = / {
    return 302 /task4/2014-national/;
  }

  location = /task4/2014-national {
    return 301 /task4/2014-national/;
  }
  location /task4/2014-national/ {
    proxy_pass http://127.0.0.1:18014/;
    include /etc/nginx/snippets/task4-proxy-common.conf;
    proxy_cookie_path / /task4/2014-national/;
    proxy_redirect ~^(/.*)$ /task4/2014-national$1;
  }

  location = /task4/2015-local {
    return 301 /task4/2015-local/;
  }
  location /task4/2015-local/ {
    proxy_pass http://127.0.0.1:18015/;
    include /etc/nginx/snippets/task4-proxy-common.conf;
    proxy_cookie_path / /task4/2015-local/;
    proxy_redirect ~^(/.*)$ /task4/2015-local$1;
  }

  location = /task4/2015-national {
    return 301 /task4/2015-national/;
  }
  location /task4/2015-national/ {
    proxy_pass http://127.0.0.1:18016/;
    include /etc/nginx/snippets/task4-proxy-common.conf;
    proxy_cookie_path / /task4/2015-national/;
    proxy_redirect ~^(/.*)$ /task4/2015-national$1;
  }

  location = /task4/2016-local {
    return 301 /task4/2016-local/;
  }
  location /task4/2016-local/ {
    proxy_pass http://127.0.0.1:18017/;
    include /etc/nginx/snippets/task4-proxy-common.conf;
    proxy_cookie_path / /task4/2016-local/;
    proxy_redirect ~^(/.*)$ /task4/2016-local$1;
  }

  location = /task4/2016-national {
    return 301 /task4/2016-national/;
  }
  location /task4/2016-national/ {
    proxy_pass http://127.0.0.1:18018/;
    include /etc/nginx/snippets/task4-proxy-common.conf;
    proxy_cookie_path / /task4/2016-national/;
    proxy_redirect ~^(/.*)$ /task4/2016-national$1;
  }

  location = /task4/2017-local {
    return 301 /task4/2017-local/;
  }
  location /task4/2017-local/ {
    proxy_pass http://127.0.0.1:18019/;
    include /etc/nginx/snippets/task4-proxy-common.conf;
    proxy_cookie_path / /task4/2017-local/;
    proxy_redirect ~^(/.*)$ /task4/2017-local$1;
  }

  location = /task4/2017-national {
    return 301 /task4/2017-national/;
  }
  location /task4/2017-national/ {
    proxy_pass http://127.0.0.1:18020/;
    include /etc/nginx/snippets/task4-proxy-common.conf;
    proxy_cookie_path / /task4/2017-national/;
    proxy_redirect ~^(/.*)$ /task4/2017-national$1;
  }
}
